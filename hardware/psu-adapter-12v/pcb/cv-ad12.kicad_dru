    (constraint clearance (min 0.2mm))
    (condition "A.insideArea('PKG_C4') && B.insideArea('PKG_C4')"))

(rule "pkg_internal_CX1"
    (constraint clearance (min 0.2mm))
    (condition "A.insideArea('PKG_CX1') && B.insideArea('PKG_CX1')"))

(rule "pkg_internal_CY1"
    (constraint clearance (min 0.2mm))
    (condition "A.insideArea('PKG_CY1') && B.insideArea('PKG_CY1')"))

(rule "pkg_internal_D1"
    (constraint clearance (min 0.2mm))
    (condition "A.insideArea('PKG_D1') && B.insideArea('PKG_D1')"))

(rule "pkg_internal_D2"
    (constraint clearance (min 0.2mm))
