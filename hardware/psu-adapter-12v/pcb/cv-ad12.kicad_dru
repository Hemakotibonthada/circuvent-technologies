    (constraint clearance (min 0.2mm))
    (condition "A.insideArea('PKG_D6') && B.insideArea('PKG_D6')"))

(rule "pkg_internal_F1"
    (constraint clearance (min 0.2mm))
    (condition "A.insideArea('PKG_F1') && B.insideArea('PKG_F1')"))

(rule "pkg_internal_PC1"
    (constraint clearance (min 0.2mm))
    (condition "A.insideArea('PKG_PC1') && B.insideArea('PKG_PC1')"))

