# Circuvent IoT API on Platform — example only. Real secrets live in .env.production (mode 600).
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://circuvent_iot_app:changeme@postgres:5432/circuvent_iot
MQTT_URL=mqtts://mqtt.circuvent.com:8883
MQTT_USERNAME=control-plane
MQTT_CONTROL_PLANE_PASSWORD=changeme
MQTT_CA_FILE=/certs/ca.crt
MQTT_TLS_REJECT_UNAUTHORIZED=true
JWT_SECRET=changeme-min-16-chars
JWT_EXPIRES_IN=30d
CORS_ORIGIN=*
AUTH_ISSUER=https://auth.circuvent.com
SSO_CLIENT_ID=smarthome
ATTENDANCE_SSO_CLIENT_ID=attendance
ATTENDANCE_SSO_ISSUER=https://myaccount.circuvent.com
FACE_EMBEDDER=http
FACE_BASE_URL=http://iot-face:8000
FACE_API_KEY=
ANPR_PROVIDER=local
SMARTHOME_CLIENT_ID=circuvent-smarthome
SMARTHOME_CLIENT_SECRET=
ADMIN_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=Circuvent <onboarding@resend.dev>
REPORT_FROM=Circuvent <info@circuvent.com>
