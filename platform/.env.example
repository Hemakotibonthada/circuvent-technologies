# Copy to .env and fill in strong random values (never commit .env).
#   openssl rand -base64 24   # use for each secret below
#
# Only variables listed in docker-compose.yml reach the container. Adding a
# value here that compose does not pass through has no effect — that is how
# FEDERATION_SECRET stayed silently unset and single sign-on kept returning 501.

# Postgres superuser password (used by the api DATABASE_URL).
POSTGRES_PASSWORD=change-me-strong

# Password for the control-plane's MQTT user. The broker runs the Dynamic
# Security plugin, so this client is created with `mosquitto_ctrl dynsec` —
# see Docs/04-mqtt-protocol.md, not the mosquitto_passwd steps in the older
# platform/README.md.
MQTT_CONTROL_PLANE_PASSWORD=change-me-strong

# JWT signing secret for app user tokens (>= 16 chars, keep secret).
#
# Rotating this signs every user out immediately, because existing tokens stop
# verifying. To end sessions without that blast radius use
# POST /auth/sign-out-all (your own account) or
# POST /admin/users/:id/revoke-sessions (an admin, for someone else).
JWT_SECRET=change-me-at-least-16-chars

# How long a session token stays valid. Sessions are revocable now, so this is
# a ceiling on an *undetected* compromise rather than the only control.
#
# Once every client in the field understands refresh tokens (web and mobile do
# as of the rotation change), shorten this to something like 15m. Short access
# tokens plus rotating refresh tokens are what make a stolen token both
# short-lived and *detectable* — see Docs/17-session-security.md section 5.
# Leaving it long is safe but forfeits the replay detection.
JWT_EXPIRES_IN=30d

# Allowed CORS origins for the API (comma-separated). Prefer listing them.
#
# `*` is accepted and is the schema default, but it lets any site call this API
# from a browser. The API authenticates with bearer tokens rather than cookies,
# so this is not by itself credential theft — a page cannot read another
# origin's localStorage — but there is no reason to publish the surface.
#   e.g. https://circuvent.com,https://dev.circuvent.com
CORS_ORIGIN=https://circuvent.com

# Shared secret for single sign-on with the storefront: the shop's Next.js
# backend signs a request with this to prove a customer is already
# authenticated, and receives a console session for the same address.
#
# Must match the corresponding secret on the website. Leave empty to disable
# federation entirely — POST /auth/federated then returns 501, so a deployment
# that has not configured it cannot be talked into minting sessions.
FEDERATION_SECRET=

# OAuth client used for Alexa / Google Home account linking.
SMARTHOME_CLIENT_ID=circuvent-smarthome
SMARTHOME_CLIENT_SECRET=

# Comma-separated emails promoted to admin on first sign-in.
ADMIN_EMAILS=

# Transactional email for sign-up OTP codes. SMTP is preferred; Resend is the
# fallback. With neither set, codes are logged instead of sent (development
# only) so sign-up still works while email is being configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
EMAIL_FROM=Circuvent <onboarding@resend.dev>
OTP_TTL_MIN=10
OTP_DEBUG=false

# ---------------------------------------------------------------------------
# ANPR — reading vehicle number plates. See Docs/20-anpr.md.
# ---------------------------------------------------------------------------
#
# Entirely optional. With ANPR_PROVIDER=none (the default) an anpr-cam still
# detects vehicles, captures them, keeps the photograph, fills the timeline and
# fires automations on arrival — it simply does not read the plate, and every
# read is stored with the reason `no_recogniser`. The console says so in as many
# words, because the only other visible symptom is an empty column that looks
# exactly like broken hardware.
#
#   local            Tesseract, running on this VM. No per-read billing, and
#                    no photograph leaves the box. Worse than a purpose-built
#                    model on a moving or angled plate — see Docs/20-anpr.md.
#   platerecognizer  purpose-built ANPR service, best accuracy
#   openai           any OpenAI-compatible vision endpoint, incl. self-hosted
#   http             your own wrapper: {plate, confidence} or {results:[...]}
ANPR_PROVIDER=none
ANPR_BASE_URL=
ANPR_API_KEY=
ANPR_MODEL=gpt-4o-mini
ANPR_REGION=in
ANPR_TIMEOUT_MS=12000

# The local recogniser. Only used when ANPR_PROVIDER=local. The binary ships in
# the API image (see api/Dockerfile); these exist so a deployment can point at
# a different build, add a language, or trade accuracy for CPU on a busy gate.
# ANPR_LOCAL_MAX_REGIONS is the CPU budget per frame — each region attempted is
# one subprocess.
ANPR_LOCAL_BINARY=tesseract
ANPR_LOCAL_LANG=eng
ANPR_LOCAL_TIMEOUT_MS=15000
ANPR_LOCAL_MAX_REGIONS=3

# A read below this is stored and shown, but never resolves to `allow`. Being
# unsure is a reason not to open a barrier — it is never a reason to skip a
# block, so `deny` still applies at any confidence.
ANPR_MIN_CONFIDENCE=70

# Retention. Images expire BEFORE the metadata, and that gap is deliberate:
# "this plate arrived at 19:42" is what an access review needs months later,
# while the photograph — which also contains whoever was walking past — is only
# useful for the few weeks in which somebody might dispute a specific read.
ANPR_RETENTION_DAYS=90
ANPR_IMAGE_RETENTION_DAYS=30
ANPR_THUMBNAIL_MAX_KB=96

# ---------------------------------------------------------------------------
# Object storage for ANPR captures — S3 or Cloudflare R2
# ---------------------------------------------------------------------------
#
# Optional. Leave S3_BUCKET empty and captures stay in `plate_reads.thumb` as
# base64, bounded by ANPR_THUMBNAIL_MAX_KB above — which is what that ceiling
# exists for: bytes in Postgres are inflated a third by base64 and carried by
# every pg_dump and every replica.
#
# With a bucket the ceiling stops applying and ANPR_IMAGE_MAX_KB (much larger)
# takes over, so a capture is no longer discarded for being a good photograph.
#
# THE BUCKET MUST BE PRIVATE. It holds pictures of vehicles, and of whoever
# happened to be walking past — personal data about people who never agreed to
# anything. It is served back through GET /anpr/reads/:id/image, which checks
# ownership. This is deliberately NOT the `circuvent-firmware` bucket: that one
# is public because a device doing an OTA check cannot sign a request.
#
# For Cloudflare R2, R2_ACCOUNT_ID alone is enough — the endpoint is derived
# from it — and the region is `auto`. For AWS S3, set S3_ENDPOINT empty,
# S3_REGION to the real region and S3_FORCE_PATH_STYLE=false.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
R2_ACCOUNT_ID=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_TIMEOUT_MS=10000

# Serve captures by redirecting to a presigned URL instead of proxying them.
# Off by default, and the default is the safer one rather than the cheaper one:
# proxying keeps the image behind the same session check as every other route
# and never puts a fetchable URL into browser history or a referrer header.
S3_PRESIGN_GET=false

# Largest capture stored as an object, in KB. A UXGA frame from an OV2640 at
# quality 10 is ~250 KB, so 1 MB holds the largest picture the hardware can
# produce and still refuses a device publishing something that is not a frame.
ANPR_IMAGE_MAX_KB=1024

# ---------------------------------------------------------------------------
# Daily gate report
# ---------------------------------------------------------------------------
#
# Sent each morning to the address configured per account in the console under
# Security > Vehicles > Site. No address there means no report; nothing is sent
# to the account holder by default, because the person who should read a gate
# report is usually a facilities or security inbox rather than the owner.
#
# The sender is deliberately NOT EMAIL_FROM. That one signs OTP and password
# resets and should be a no-reply identity; a report is something somebody
# replies to. It must stay on a domain the mail server signs with DKIM —
# mail.circuvent.com signs circuvent.com — or every report fails DMARC and
# lands in spam.
#
# Delivery uses the same SMTP_* settings above, which point at the indigenous
# Postfix server (see the Mail.circuvent repository), with Resend as fallback.
REPORT_FROM=Circuvent <info@circuvent.com>

# ---------------------------------------------------------------- FaceDoor --
# Face embedding for the face-recognition door lock.
#
# Optional. With "none" the lock still works: faces are enrolled at the door,
# a hub with its own model can post descriptors directly, and matching, access
# windows and the attempt log are unaffected. Only enrolling from a photograph
# taken on a phone needs this.
#
# It MUST be the same model the recogniser matches against. Two 128-number
# embeddings from different networks are the same shape and mean different
# things, so a mismatch would enrol faces that silently never match.
FACE_EMBEDDER=none
FACE_BASE_URL=
FACE_API_KEY=
FACE_TIMEOUT_MS=10000