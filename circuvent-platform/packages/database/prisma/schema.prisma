  assetCode       String   @unique
  name            String
  category        String   // LAPTOP, MONITOR, KEYBOARD, MOUSE, HEADSET, PHONE, FURNITURE, OTHER
  brand           String?
  model           String?
  serialNumber    String?  @unique
  purchaseDate    DateTime?
  purchasePrice   Decimal? @db.Decimal(12, 2)
