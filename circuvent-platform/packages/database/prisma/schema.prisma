// SHIFT & SCHEDULE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

model ShiftDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  startTime   String   // "09:00"
  endTime     String   // "18:00"
  breakMinutes Int     @default(60)
  isNightShift Boolean @default(false)
  color       String   @default("#3b82f6")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  schedules   ShiftSchedule[]

  @@map("shift_definitions")
}

model ShiftSchedule {
  id          String   @id @default(cuid())
  employeeId  String
  shiftId     String
  date        DateTime @db.Date
  status      String   @default("SCHEDULED") // SCHEDULED, CHECKED_IN, COMPLETED, ABSENT, SWAPPED
  swapRequestedWith String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shift       ShiftDefinition @relation(fields: [shiftId], references: [id])
  employee    Employee        @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([shiftId])
  @@map("shift_schedules")
}

// ═══════════════════════════════════════════════════════════════
// Travel Management
// ═══════════════════════════════════════════════════════════════

enum TravelStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TravelRequest {
  id              String       @id @default(cuid())
  employeeId      String
  purpose         String
  destination     String
  departureDate   DateTime
  returnDate      DateTime
  estimatedBudget Float
  actualCost      Float?
  status          TravelStatus @default(DRAFT)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  itineraries     TravelItinerary[]
  travelExpenses  TravelExpense[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("travel_requests")
}

model TravelItinerary {
  id              String   @id @default(cuid())
  travelRequestId String
  segmentType     String   // FLIGHT, HOTEL, TRAIN, BUS, CAB
  fromLocation    String
  toLocation      String?
  departureTime   DateTime
  arrivalTime     DateTime?
  carrier         String?
  bookingRef      String?
  cost            Float    @default(0)
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  travelRequest   TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)

  @@index([travelRequestId])
  @@map("travel_itineraries")
}

model TravelExpense {
  id              String   @id @default(cuid())
  travelRequestId String
  category        String   // TRANSPORT, ACCOMMODATION, MEALS, MISC
  description     String
  amount          Float
  currency        String   @default("INR")
  receiptUrl      String?
  date            DateTime
  createdAt       DateTime @default(now())

  travelRequest   TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)

  @@index([travelRequestId])
  @@map("travel_expenses")
}

model TravelPolicy {
  id              String   @id @default(cuid())
  name            String
  maxDailyAllowance Float
  maxHotelRate    Float
  maxFlightClass  String   @default("ECONOMY")
  requiresApproval Boolean @default(true)
  approvalThreshold Float  @default(10000)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("travel_policies")
}

// ═══════════════════════════════════════════════════════════════
// Calendar System
// ═══════════════════════════════════════════════════════════════

enum EventType {
  MEETING
  INTERVIEW
  TRAINING
  HOLIDAY
  PERSONAL
  TEAM_EVENT
  DEADLINE
  REMINDER
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model CalendarEvent {
  id            String         @id @default(cuid())
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean        @default(false)
  eventType     EventType      @default(MEETING)
  recurrence    RecurrenceRule @default(NONE)
  location      String?
  meetingUrl    String?
  organizerId   String
  isPrivate     Boolean        @default(false)
  color         String?
  attendees     EventAttendee[]
  reminders     EventReminder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([organizerId])
  @@index([startTime, endTime])
  @@map("calendar_events")
}

model EventAttendee {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  status        String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, TENTATIVE
  responseAt    DateTime?
  createdAt     DateTime @default(now())

  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_attendees")
}

model EventReminder {
  id            String   @id @default(cuid())
  eventId       String
  minutesBefore Int      @default(15)
  type          String   @default("NOTIFICATION") // NOTIFICATION, EMAIL
  sent          Boolean  @default(false)
  createdAt     DateTime @default(now())

  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_reminders")
}

model MeetingRoom {
  id            String   @id @default(cuid())
  name          String
  location      String
  capacity      Int
  amenities     String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("meeting_rooms")
}

// ═══════════════════════════════════════════════════════════════
// Timesheet
// ═══════════════════════════════════════════════════════════════

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Timesheet {
  id          String          @id @default(cuid())
  employeeId  String
  weekStart   DateTime        @db.Date
  weekEnd     DateTime        @db.Date
  totalHours  Float           @default(0)
  status      TimesheetStatus @default(DRAFT)
  approvedBy  String?
  approvedAt  DateTime?
  comments    String?
  entries     TimesheetEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, weekStart])
  @@index([employeeId])
  @@index([status])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String   @id @default(cuid())
  timesheetId String
  projectId   String?
  taskId      String?
  date        DateTime @db.Date
  hours       Float
  description String?
  category    String   @default("DEVELOPMENT") // DEVELOPMENT, MEETING, REVIEW, ADMIN, LEARNING
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())

  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
  @@index([date])
  @@map("timesheet_entries")
}

// ═══════════════════════════════════════════════════════════════
// Workflow Automation
// ═══════════════════════════════════════════════════════════════

enum WorkflowStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WorkflowInstanceStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

enum WorkflowStepType {
  APPROVAL
  NOTIFICATION
  WEBHOOK
  CONDITION
  DELAY
  ACTION
  EMAIL
}

model WorkflowTemplate {
  id          String         @id @default(cuid())
  name        String
  description String?
  triggerType String         // EMPLOYEE_ONBOARD, LEAVE_REQUEST, EXPENSE_SUBMIT, ASSET_REQUEST, TRAVEL_REQUEST, MANUAL, SCHEDULED
  triggerConfig Json?
  status      WorkflowStatus @default(ACTIVE)
  version     Int            @default(1)
  createdBy   String
  steps       WorkflowStepDef[]
  instances   WorkflowInstance[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([triggerType])
  @@index([status])
  @@map("workflow_templates")
}

model WorkflowStepDef {
  id          String           @id @default(cuid())
  templateId  String
  name        String
  stepType    WorkflowStepType
  config      Json             // Approval: {approverRole, autoApproveAfter}, Notification: {channel, template}, etc.
  sortOrder   Int
  isRequired  Boolean          @default(true)
  timeoutMins Int?
  createdAt   DateTime         @default(now())

  template    WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("workflow_step_defs")
}

model WorkflowInstance {
  id          String                 @id @default(cuid())
  templateId  String
  entityType  String                 // LeaveRecord, ExpenseClaim, TravelRequest, etc.
  entityId    String
  status      WorkflowInstanceStatus @default(RUNNING)
  currentStep Int                    @default(0)
  context     Json?                  // Runtime data passed between steps
  startedBy   String
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  error       String?
  logs        WorkflowLog[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  template    WorkflowTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
  @@index([entityType, entityId])
  @@index([status])
  @@map("workflow_instances")
}

model WorkflowLog {
  id          String   @id @default(cuid())
  instanceId  String
  stepIndex   Int
  stepName    String
  action      String   // STARTED, APPROVED, REJECTED, SKIPPED, ERROR, AUTO_APPROVED, NOTIFIED
  actorId     String?
  data        Json?
  createdAt   DateTime @default(now())

  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("workflow_logs")
}

// ═══════════════════════════════════════════════════════════════
// Recognition & Awards
// ═══════════════════════════════════════════════════════════════

model Recognition {
  id          String   @id @default(cuid())
  giverId     String
  receiverId  String
  type        String   @default("KUDOS") // KUDOS, SHOUTOUT, AWARD, SPOT_BONUS
  category    String   @default("TEAMWORK") // TEAMWORK, INNOVATION, LEADERSHIP, EXCELLENCE, CUSTOMER_FOCUS
  message     String
  points      Int      @default(10)
  isPublic    Boolean  @default(true)
  reactions   Json?    // {emoji: count}
  createdAt   DateTime @default(now())

  @@index([giverId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("recognitions")
}

model AwardProgram {
  id          String   @id @default(cuid())
  name        String
  description String?
  frequency   String   @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL, AD_HOC
  pointValue  Int      @default(100)
  isActive    Boolean  @default(true)
  nominations AwardNomination[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("award_programs")
}

model AwardNomination {
  id          String   @id @default(cuid())
  programId   String
  nomineeId   String
  nominatorId String
  reason      String
  status      String   @default("PENDING") // PENDING, SHORTLISTED, WINNER, REJECTED
  period      String   // "2026-Q1", "2026-03", etc.
  votesCount  Int      @default(0)
  createdAt   DateTime @default(now())

  program     AwardProgram @relation(fields: [programId], references: [id])

  @@index([programId])
  @@index([nomineeId])
  @@map("award_nominations")
}

// ═══════════════════════════════════════════════════════════════
// Document Management
// ═══════════════════════════════════════════════════════════════

model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   // OFFER_LETTER, PAYSLIP, CONTRACT, NDA, EXPERIENCE_LETTER, RELIEVING_LETTER
  content     String   @db.Text // HTML/Mustache template
  variables   Json?    // [{name, type, required}]
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

