  @@map("document_templates")
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  templateId  String?
  name        String
  category    String
  content     String?  @db.Text
  fileUrl     String?
  format      String   @default("PDF") // PDF, DOCX, HTML
  entityType  String?  // Employee, Candidate, etc.
  entityId    String?
  generatedBy String
  data        Json?    // Variables used for generation
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([category])
  @@map("generated_documents")
}

// ═══════════════════════════════════════════════════════════════
// Feature Flags
// ═══════════════════════════════════════════════════════════════

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  targetRoles String[] @default([])
  percentage  Int      @default(100) // 0-100 rollout percentage
  metadata    Json?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ═══════════════════════════════════════════════════════════════
// Visitor Management
// ═══════════════════════════════════════════════════════════════

model Visitor {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  purpose     String
  hostId      String   // Employee who they're visiting
  badgeNumber String?
  photoUrl    String?
  idType      String?  // AADHAAR, PAN, PASSPORT, DRIVING_LICENSE
  idNumber    String?
  checkInAt   DateTime?
  checkOutAt  DateTime?
  status      String   @default("PRE_REGISTERED") // PRE_REGISTERED, CHECKED_IN, CHECKED_OUT, DENIED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hostId])
  @@index([status])
  @@index([checkInAt])
  @@map("visitors")
}

// ═══════════════════════════════════════════════════════════════
// Survey System
// ═══════════════════════════════════════════════════════════════

model Survey {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("ENGAGEMENT") // ENGAGEMENT, FEEDBACK, PULSE, EXIT, CUSTOM
  status      String   @default("DRAFT") // DRAFT, ACTIVE, CLOSED, ARCHIVED
  startDate   DateTime?
  endDate     DateTime?
  isAnonymous Boolean  @default(false)
  createdBy   String
  questions   SurveyQuestion[]
  responses   SurveyResponse[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("surveys")
}

model SurveyQuestion {
  id          String   @id @default(cuid())
  surveyId    String
  text        String
  type        String   @default("RATING") // RATING, TEXT, MULTIPLE_CHOICE, CHECKBOX, SCALE
  options     Json?    // For MULTIPLE_CHOICE / CHECKBOX
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers     SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  respondentId String?  // null if anonymous
  answers     SurveyAnswer[]
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  survey      Survey @relation(fields: [surveyId], references: [id])

  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id          String   @id @default(cuid())
  responseId  String
  questionId  String
  value       String   // Text answer or selected option
  numericValue Float?  // For RATING/SCALE
  createdAt   DateTime @default(now())

  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question    SurveyQuestion @relation(fields: [questionId], references: [id])

  @@index([responseId])
  @@index([questionId])
  @@map("survey_answers")
}

// ═══════════════════════════════════════════════════════════════
// Benefits Administration
// ═══════════════════════════════════════════════════════════════

model BenefitPlan {
  id          String   @id @default(cuid())
  name        String
  type        String   // HEALTH, DENTAL, VISION, LIFE, RETIREMENT, FSA, HSA
  provider    String?
  description String?
  premium     Float    @default(0)
  employerContribution Float @default(0)
  coverageDetails Json?
  isActive    Boolean  @default(true)
  enrollments BenefitEnrollment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefit_plans")
}

model BenefitEnrollment {
  id          String   @id @default(cuid())
  planId      String
  employeeId  String
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE, CANCELLED, EXPIRED
  dependents  Json?    // [{name, relation, dob}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan        BenefitPlan @relation(fields: [planId], references: [id])

  @@index([employeeId])
  @@index([planId])
  @@map("benefit_enrollments")
}

// ═══════════════════════════════════════════════════════════════
// HR Letter Management — Offer, Experience, Relieving, Internship, etc.
// ═══════════════════════════════════════════════════════════════

enum LetterType {
  OFFER_LETTER
  APPOINTMENT_LETTER
  CALL_LETTER
  EXPERIENCE_LETTER
  RELIEVING_LETTER
  INTERNSHIP_LETTER
  INTERNSHIP_COMPLETION
  PROBATION_CONFIRMATION
  PROMOTION_LETTER
  TRANSFER_LETTER
  WARNING_LETTER
  TERMINATION_LETTER
  SALARY_REVISION_LETTER
  BONUS_LETTER
  NDA_AGREEMENT
  NON_COMPETE
  EMPLOYMENT_VERIFICATION
  ADDRESS_PROOF
  REFERENCE_LETTER
  APPRECIATION_LETTER
  CUSTOM
}

enum LetterStatus {
  DRAFT
  GENERATED
  SENT
  ACKNOWLEDGED
  SIGNED
  REJECTED
  REVOKED
}

model LetterTemplate {
  id            String     @id @default(cuid())
  name          String
  letterType    LetterType
  subject       String     // Email subject line
  htmlContent   String     @db.Text // HTML template with {{variables}}
  variables     Json?      // [{name, type, required, defaultValue}]
  category      String     @default("EMPLOYMENT") // EMPLOYMENT, COMPLIANCE, INTERNSHIP, RECOGNITION, EXIT
  isActive      Boolean    @default(true)
  version       Int        @default(1)
  createdBy     String
  letters       Letter[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([letterType])
  @@index([category])
  @@map("letter_templates")
}

model Letter {
  id            String       @id @default(cuid())
  templateId    String?
  letterType    LetterType
  recipientId   String       // User ID of recipient
  recipientName String
  recipientEmail String
  subject       String
  htmlContent   String       @db.Text // Final rendered HTML
  pdfUrl        String?      // Generated PDF link
  status        LetterStatus @default(DRAFT)
  sentAt        DateTime?
  sentBy        String?
  acknowledgedAt DateTime?
  signedAt      DateTime?
  signatureUrl  String?
  metadata      Json?        // Extra data: salary, designation, dept, etc.
  notes         String?
  expiresAt     DateTime?    // E.g. offer letter validity
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  template      LetterTemplate? @relation(fields: [templateId], references: [id])

  @@index([recipientId])
  @@index([letterType])
  @@index([status])
  @@index([sentBy])
  @@map("letters")
}

model LetterBatch {
  id            String   @id @default(cuid())
  name          String
  letterType    LetterType
  templateId    String
  recipientIds  String[] // User IDs
  totalCount    Int
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  startedAt     DateTime?
  completedAt   DateTime?
  createdBy     String
  errors        Json?    // [{recipientId, error}]
  createdAt     DateTime @default(now())

  @@index([status])
  @@map("letter_batches")
}

// ═══════════════════════════════════════════════════════════════
// Material / Purchase Request System
// ═══════════════════════════════════════════════════════════════

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  FINANCE_APPROVED
  PROCUREMENT_PROCESSING
  ORDERED
  DELIVERED
  BILL_SUBMITTED
  REIMBURSED
  REJECTED
  CANCELLED
}

enum PurchaseType {
  ADVANCE_PURCHASE    // Request money before buying
  REIMBURSEMENT       // Already purchased, requesting reimbursement
  COMPANY_DIRECT      // Company purchases directly
}

model PurchaseRequest {
  id              String                @id @default(cuid())
  requestNumber   String                @unique
  employeeId      String
  department      String
  purchaseType    PurchaseType          @default(ADVANCE_PURCHASE)
  title           String
  description     String?
  justification   String
  totalAmount     Float
  currency        String                @default("INR")
  status          PurchaseRequestStatus @default(DRAFT)
  urgency         String                @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  vendorName      String?
  vendorContact   String?
  expectedDelivery DateTime?
  items           PurchaseItem[]
  approvals       PurchaseApproval[]
  transactions    FundTransaction[]
  // Manager approval
  managerApprovedBy String?
  managerApprovedAt DateTime?
  managerNotes    String?
  // Finance approval
  financeApprovedBy String?
  financeApprovedAt DateTime?
  financeNotes    String?
  // Delivery
  deliveredAt     DateTime?
  deliveryNotes   String?
  // Bill/Receipt
  billUrl         String?
  billNumber      String?
  billDate        DateTime?
  actualAmount    Float?
  // Reimbursement
  reimbursedAt    DateTime?
  reimbursementRef String?
  // Rejection
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([employeeId])
  @@index([department])
  @@index([status])
  @@index([purchaseType])
  @@map("purchase_requests")
}

model PurchaseItem {
  id              String   @id @default(cuid())
  purchaseRequestId String
  name            String
  description     String?
  category        String   // HARDWARE, SOFTWARE, OFFICE_SUPPLIES, LAB_EQUIPMENT, RAW_MATERIAL, SERVICES, OTHER
  quantity        Int      @default(1)
  unitPrice       Float
  totalPrice      Float
  specifications  String?
  preferredVendor String?
  alternateVendor String?
  createdAt       DateTime @default(now())

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@map("purchase_items")
}

model PurchaseApproval {
  id              String   @id @default(cuid())
  purchaseRequestId String
  approverId      String
  approverRole    String   // MANAGER, FINANCE, ADMIN, CEO
  action          String   // APPROVED, REJECTED, ESCALATED
  comments        String?
  amount          Float?   // Approved amount (may differ from requested)
  createdAt       DateTime @default(now())

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@index([approverId])
  @@map("purchase_approvals")
}

// ═══════════════════════════════════════════════════════════════
// Funds & Budget Management
// ═══════════════════════════════════════════════════════════════

enum FundCategory {
  OPERATIONAL
  CAPITAL
  PROJECT
  DEPARTMENT
  EMERGENCY
  PETTY_CASH
  TRAVEL
  TRAINING
  RECRUITMENT
  MARKETING
  R_AND_D
  INFRASTRUCTURE
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER
  HOLD
  RELEASE
  REFUND
}

model Fund {
  id              String       @id @default(cuid())
  name            String
  code            String       @unique
  category        FundCategory
  description     String?
  totalBudget     Float
  allocatedAmount Float        @default(0)
  spentAmount     Float        @default(0)
  remainingAmount Float        @default(0)
  currency        String       @default("INR")
  fiscalYear      String       // "FY 2025-26"
  department      String?
  projectId       String?
  managerId       String       // Who manages this fund
  isActive        Boolean      @default(true)
  startDate       DateTime?
  endDate         DateTime?
  transactions    FundTransaction[]
  allocations     FundAllocation[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([category])
  @@index([department])
  @@index([fiscalYear])
  @@index([managerId])
  @@map("funds")
}

model FundAllocation {
  id              String   @id @default(cuid())
  fundId          String
  allocatedTo     String   // Department or project or employee
  allocationType  String   // DEPARTMENT, PROJECT, EMPLOYEE, VENDOR
  amount          Float
  purpose         String
  approvedBy      String
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fund            Fund     @relation(fields: [fundId], references: [id])

  @@index([fundId])
  @@index([allocatedTo])
  @@map("fund_allocations")
}

model FundTransaction {
  id                String          @id @default(cuid())
  fundId            String
  transactionType   TransactionType
  amount            Float
  description       String
  referenceType     String?         // PurchaseRequest, ExpenseClaim, SalaryPayment, etc.
  referenceId       String?
  purchaseRequestId String?
  bankAccount       String?         // Company bank account used
  beneficiaryAccount String?        // Recipient bank account
  beneficiaryName   String?
  transferRef       String?         // Bank reference / UTR number
  status            String          @default("COMPLETED") // PENDING, COMPLETED, FAILED, REVERSED
  processedAt       DateTime?
  processedBy       String?
  balanceBefore     Float?
  balanceAfter      Float?
  notes             String?
  createdAt         DateTime        @default(now())

  fund              Fund            @relation(fields: [fundId], references: [id])
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])

  @@index([fundId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([purchaseRequestId])
  @@map("fund_transactions")
}

model CompanyBankAccount {
  id              String   @id @default(cuid())
  bankName        String
  accountNumber   String
  ifscCode        String
  branchName      String
  accountType     String   @default("CURRENT") // CURRENT, SAVINGS
  balance         Float    @default(0)
  currency        String   @default("INR")
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("company_bank_accounts")
}
