}

model Resignation {
  id              String    @id @default(cuid())
  employeeId      String
  reason          String    @db.Text
  lastWorkingDate DateTime?
  noticePeriod    Int       @default(30) // days
  status          String    @default("SUBMITTED") // SUBMITTED, ACCEPTED, REJECTED, WITHDRAWN, COMPLETED
  processedBy     String?
  processedAt     DateTime?
  exitInterviewDone Boolean @default(false)
  exitInterviewNotes String? @db.Text
  createdAt       DateTime  @default(now())
