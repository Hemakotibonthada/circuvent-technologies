  employeeId      String
  category        String   // HARASSMENT, DISCRIMINATION, POLICY, COMPENSATION, WORKPLACE, OTHER
  subject         String
  description     String   @db.Text
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, CLOSED, ESCALATED, WITHDRAWN
  assignedTo      String?
  resolution      String?  @db.Text
  resolvedAt      DateTime?
  isAnonymous     Boolean  @default(false)
  isConfidential  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("grievances")
}

