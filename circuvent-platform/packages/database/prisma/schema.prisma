// ──────────────────────────────────────────────────────────────────────────────
// Circuvent Technologies — Unified Database Schema
// Single Source of Truth linking all 4 modules:
//   1. Project & Engineering Tracker
//   2. IoT Device Registry
//   3. HR & Payroll Engine
//   4. Client & Consulting Portal
// Plus: Audit Logs, Multi-Currency, RBAC, R&D Tax Tagging
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CORE — Authentication, Users & RBAC
// ═══════════════════════════════════════════════════════════════════════════════

enum Role {
  ADMIN
  SUPER_ADMIN
  HR_MANAGER
  MANAGER
  PRODUCT_MANAGER
  ENGINEER
  DEVELOPER
  TESTER
  INTERN
  MARKETING
  CEO
  CLIENT
  CANDIDATE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role       @default(ENGINEER)
  status        UserStatus @default(ACTIVE)
  avatarUrl     String?
  phone         String?
  department    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations — HR
  employee      Employee?

  // Relations — Project Tracker
  assignedTasks   SprintTask[]       @relation("TaskAssignee")
  createdTasks    SprintTask[]       @relation("TaskCreator")
  projectMembers  ProjectMember[]

  // Relations — Client Portal
  clientProfile   ClientProfile?
  createdLeads    Lead[]             @relation("LeadCreator")
  assignedLeads   Lead[]             @relation("LeadAssignee")
  createdInvoices Invoice[]

  // Relations — IoT
  registeredDevices IoTDevice[]      @relation("DeviceRegistrar")

  // Relations — Audit
  auditLogs       AuditLog[]

  // Relations — Auth
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 1 — Project & Engineering Tracker
// Supports Sprints (Software) and Hardware Revision Tracking (BOM)
// ═══════════════════════════════════════════════════════════════════════════════

enum ProjectType {
  SOFTWARE
  HARDWARE
  HYBRID
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id            String        @id @default(cuid())
  name          String
  code          String        @unique  // e.g., "PROJ-001"
  description   String?
  type          ProjectType
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  endDate       DateTime?
  budget        Decimal?      @db.Decimal(15, 2)
  budgetCurrency String       @default("INR")
  isRnD         Boolean       @default(false)  // R&D Tax Tagging
  rnDCategory   String?       // R&D classification for tax purposes
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  members       ProjectMember[]
  sprints       Sprint[]
  hardwareRevisions HardwareRevision[]
  devices       IoTDevice[]       // IoT devices linked to this project
  clientProject ClientProject[]   // Linked client engagements

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // lead, member, reviewer
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ── Software Sprints ──

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Sprint {
  id          String       @id @default(cuid())
  name        String
  projectId   String
  sprintNumber Int
  goal        String?
  status      SprintStatus @default(PLANNED)
  startDate   DateTime
  endDate     DateTime
  velocity    Int?         // story points completed
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       SprintTask[]

  @@unique([projectId, sprintNumber])
  @@map("sprints")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model SprintTask {
  id            String       @id @default(cuid())
  title         String
  description   String?
  sprintId      String
  assigneeId    String?
  creatorId     String
  status        TaskStatus   @default(BACKLOG)
  priority      TaskPriority @default(MEDIUM)
  storyPoints   Int?
  tags          String[]     // labels: bug, feature, chore, etc.
  isRnDRelated  Boolean      @default(false)  // R&D Tax Tagging
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sprint        Sprint       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator       User         @relation("TaskCreator", fields: [creatorId], references: [id])

  @@map("sprint_tasks")
}

// ── Hardware Revision Tracking (BOM) ──

enum RevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PRODUCTION
  DEPRECATED
}

model HardwareRevision {
  id            String         @id @default(cuid())
  projectId     String
  revisionCode  String         // e.g., "REV-A", "REV-B"
  title         String
  description   String?
  status        RevisionStatus @default(DRAFT)
  schematicUrl  String?        // link to schematic file
  pcbLayoutUrl  String?        // link to PCB layout
  isRnDRelated  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bomItems      BOMItem[]

  @@unique([projectId, revisionCode])
  @@map("hardware_revisions")
}

model BOMItem {
  id              String   @id @default(cuid())
  revisionId      String
  partNumber      String
  partName        String
  description     String?
  manufacturer    String?
  supplier        String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 4)
  currency        String   @default("INR")
  leadTimeDays    Int?
  category        String?  // resistor, capacitor, IC, connector, etc.
  isRnDComponent  Boolean  @default(false)  // R&D Tax Tagging
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  revision        HardwareRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  expenseClaims   ExpenseItem[]    // Links to HR expense reimbursements

  @@map("bom_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 2 — IoT Device Registry
// ═══════════════════════════════════════════════════════════════════════════════

enum DeviceStatus {
  REGISTERED
  PROVISIONED
  ONLINE
  OFFLINE
  MAINTENANCE
  DECOMMISSIONED
}

model IoTDevice {
  id              String       @id @default(cuid())
  deviceName      String
  deviceCode      String       @unique  // internal device identifier
  macAddress      String       @unique
  ipAddress       String?
  firmwareVersion String
  hardwareModel   String?
  status          DeviceStatus @default(REGISTERED)
  projectId       String?      // linked to a project
  registeredById  String
  location        String?      // physical deployment location
  lastHeartbeat   DateTime?
  metadata        Json?        // flexible key-value for sensor configs
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project         Project?     @relation(fields: [projectId], references: [id])
  registeredBy    User         @relation("DeviceRegistrar", fields: [registeredById], references: [id])
  firmwareHistory FirmwareUpdate[]
  telemetryLogs   TelemetryLog[]
  heartbeats      DeviceHeartbeat[]
  alerts          DeviceAlert[]
  commands        DeviceCommand[]

  @@map("iot_devices")
}

model FirmwareUpdate {
  id            String   @id @default(cuid())
  deviceId      String
  fromVersion   String
  toVersion     String
  status        String   @default("pending") // pending, in_progress, completed, failed
  initiatedAt   DateTime @default(now())
  completedAt   DateTime?
  notes         String?

  device        IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("firmware_updates")
}

model TelemetryLog {
  id          String   @id @default(cuid())
  deviceId    String
  timestamp   DateTime @default(now())
  payload     Json     // sensor readings, status data
  logLevel    String   @default("INFO") // INFO, WARN, ERROR, CRITICAL

  device      IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@map("telemetry_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 3 — HR & Payroll Engine
// India-based tax compliance, R&D expense tagging
// ═══════════════════════════════════════════════════════════════════════════════

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum PayFrequency {
  MONTHLY
  BI_WEEKLY
}

model Employee {
  id                String         @id @default(cuid())
  userId            String         @unique
  employeeCode      String         @unique  // e.g., "CIR-EMP-001"
  employmentType    EmploymentType @default(FULL_TIME)
  designation       String
  department        String
  dateOfJoining     DateTime
  dateOfLeaving     DateTime?
  baseSalary        Decimal        @db.Decimal(12, 2)
  currency          String         @default("INR")
  payFrequency      PayFrequency   @default(MONTHLY)

  // India Tax Compliance
  panNumber         String?        // PAN card
  aadhaarNumber     String?        // Aadhaar (encrypted)
  uanNumber         String?        // Universal Account Number (PF)
  bankAccountNo     String?
  bankIFSC          String?
  pfContribution    Decimal?       @db.Decimal(10, 2)
  esiContribution   Decimal?       @db.Decimal(10, 2)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  salarySlips       SalarySlip[]
  expenseClaims     ExpenseClaim[]
  taxDeclarations   TaxDeclaration[]
  leaveRecords      LeaveRecord[]
  attendanceLogs    AttendanceLog[]
  performanceReviews PerformanceReview[]
  goals             Goal[]
  documents         EmployeeDocument[]
  helpTickets       HelpTicket[]
  trainings         TrainingEnrollment[]
  shiftSchedules    ShiftSchedule[]

  @@map("employees")
}

model SalarySlip {
  id              String   @id @default(cuid())
  employeeId      String
  month           Int      // 1-12
  year            Int
  basePay         Decimal  @db.Decimal(12, 2)
  hra             Decimal  @db.Decimal(12, 2)  // House Rent Allowance
  da              Decimal  @db.Decimal(12, 2)  // Dearness Allowance
  specialAllowance Decimal @db.Decimal(12, 2)
  bonus           Decimal  @db.Decimal(12, 2) @default(0)
  grossSalary     Decimal  @db.Decimal(12, 2)

  // Deductions (India)
  pfDeduction     Decimal  @db.Decimal(10, 2) @default(0)  // Provident Fund
  esiDeduction    Decimal  @db.Decimal(10, 2) @default(0)  // ESI
  professionalTax Decimal  @db.Decimal(10, 2) @default(0)
  tds             Decimal  @db.Decimal(10, 2) @default(0)  // Tax Deducted at Source
  otherDeductions Decimal  @db.Decimal(10, 2) @default(0)
  totalDeductions Decimal  @db.Decimal(12, 2)

  netSalary       Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR")
  isPaid          Boolean  @default(false)
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("salary_slips")
}

model TaxDeclaration {
  id              String   @id @default(cuid())
  employeeId      String
  financialYear   String   // e.g., "2025-2026"
  regime          String   @default("NEW") // OLD or NEW tax regime
  section80C      Decimal  @db.Decimal(10, 2) @default(0)
  section80D      Decimal  @db.Decimal(10, 2) @default(0)
  section24       Decimal  @db.Decimal(10, 2) @default(0) // Home loan interest
  hra_exemption   Decimal  @db.Decimal(10, 2) @default(0)
  otherExemptions Decimal  @db.Decimal(10, 2) @default(0)
  totalDeclared   Decimal  @db.Decimal(12, 2)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, financialYear])
  @@map("tax_declarations")
}

model LeaveRecord {
  id          String   @id @default(cuid())
  employeeId  String
  leaveType   String   // CASUAL, SICK, EARNED, MATERNITY, etc.
  startDate   DateTime
  endDate     DateTime
  totalDays   Decimal  @db.Decimal(4, 1)
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_records")
}

// ── Expense Reimbursement (linked to BOM for R&D components) ──

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

model ExpenseClaim {
  id            String        @id @default(cuid())
  employeeId    String
  claimCode     String        @unique  // e.g., "EXP-2025-001"
  title         String
  description   String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  status        ExpenseStatus @default(DRAFT)
  isRnDExpense  Boolean       @default(false)  // R&D Tax Tagging
  rnDCategory   String?       // Type of R&D expense
  submittedAt   DateTime?
  approvedAt    DateTime?
  reimbursedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items         ExpenseItem[]

  @@map("expense_claims")
}

model ExpenseItem {
  id            String   @id @default(cuid())
  claimId       String
  description   String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  receiptUrl    String?
  bomItemId     String?  // Links to BOM for R&D component purchase
  isRnDRelated  Boolean  @default(false)
  createdAt     DateTime @default(now())

  claim         ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  bomItem       BOMItem?     @relation(fields: [bomItemId], references: [id])

  @@map("expense_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 4 — Client & Consulting Portal
// Lead Tracking, Invoicing, Multi-currency Support
// ═══════════════════════════════════════════════════════════════════════════════

model ClientProfile {
  id              String   @id @default(cuid())
  userId          String   @unique  // links to User with CLIENT role
  companyName     String
  industry        String?
  website         String?
  country         String   @default("India")
  preferredCurrency String @default("INR")
  taxId           String?  // GST number or VAT
  billingAddress  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads           Lead[]
  invoices        Invoice[]
  projects        ClientProject[]

  @@map("client_profiles")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  CONFERENCE
  COLD_OUTREACH
  OTHER
}

model Lead {
  id              String     @id @default(cuid())
  title           String
  description     String?
  clientId        String?
  createdById     String
  assignedToId    String?
  status          LeadStatus @default(NEW)
  source          LeadSource @default(OTHER)
  estimatedValue  Decimal?   @db.Decimal(15, 2)
  currency        String     @default("INR")
  probability     Int?       // 0-100 win probability
  expectedCloseDate DateTime?
  tags            String[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  client          ClientProfile? @relation(fields: [clientId], references: [id])
  createdBy       User           @relation("LeadCreator", fields: [createdById], references: [id])
  assignedTo      User?          @relation("LeadAssignee", fields: [assignedToId], references: [id])
  activities      LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  type        String   // call, email, meeting, note
  title       String
  description String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

// ── Client Projects (links Client Portal to Project Tracker) ──

model ClientProject {
  id          String   @id @default(cuid())
  clientId    String
  projectId   String
  contractValue Decimal? @db.Decimal(15, 2)
  currency    String   @default("INR")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())

  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientId, projectId])
  @@map("client_projects")
}

// ── Invoicing with Multi-Currency ──

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique  // e.g., "INV-2025-001"
  clientId        String
  createdById     String
  title           String
  description     String?
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(15, 2)
  taxRate         Decimal       @db.Decimal(5, 2) @default(18)  // GST default 18%
  taxAmount       Decimal       @db.Decimal(15, 2)
  discount        Decimal       @db.Decimal(15, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(15, 2)

  // Multi-currency support
  currency        String        @default("INR")
  exchangeRate    Decimal       @db.Decimal(12, 6) @default(1)  // rate to base currency
  baseCurrencyTotal Decimal     @db.Decimal(15, 2)  // amount in INR for accounting

  // Payment
  paidAmount      Decimal       @db.Decimal(15, 2) @default(0)
  paidAt          DateTime?
  paymentMethod   String?
  paymentRef      String?

  notes           String?
  termsConditions String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client          ClientProfile @relation(fields: [clientId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])
  lineItems       InvoiceLineItem[]

  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(15, 2)
  taxable     Boolean @default(true)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PLATFORM — Audit Logs, Currency Rates, Notifications
// ═══════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity      String   // table/model name
  entityId    String?
  oldValue    Json?    // previous state
  newValue    Json?    // new state
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(12, 6)
  source       String   @default("API") // API, MANUAL
  fetchedAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency, fetchedAt])
  @@index([fromCurrency, toCurrency])
  @@map("currency_rates")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   // info, warning, error, success
  module      String   // project, iot, hr, client
  isRead      Boolean  @default(false)
  actionUrl   String?
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ── R&D Tax Tagging Summary (aggregated view support) ──

model RnDTaxRecord {
  id              String   @id @default(cuid())
  financialYear   String
  category        String   // software_dev, hardware_dev, component_purchase, salary
  description     String
  amount          Decimal  @db.Decimal(15, 2)
  currency        String   @default("INR")
  sourceEntity    String   // project, bom_item, expense, salary
  sourceEntityId  String
  isApproved      Boolean  @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([financialYear, category])
  @@map("rnd_tax_records")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PHASE 2 — Advanced HR Statutory Compliance (India)
// EPF, ESI, TDS, Professional Tax, Gratuity
// ═══════════════════════════════════════════════════════════════════════════════

model StatutoryConfig {
  id                String   @id @default(cuid())
  financialYear     String   @unique // e.g., "2025-2026"
  epfEmployeeRate   Decimal  @db.Decimal(5, 4) @default(0.12)
  epfEmployerRate   Decimal  @db.Decimal(5, 4) @default(0.12)
  epfWageCeiling    Decimal  @db.Decimal(12, 2) @default(15000)
  epsRate           Decimal  @db.Decimal(5, 4) @default(0.0833)
  esiEmployeeRate   Decimal  @db.Decimal(5, 4) @default(0.0075)
  esiEmployerRate   Decimal  @db.Decimal(5, 4) @default(0.0325)
  esiWageCeiling    Decimal  @db.Decimal(12, 2) @default(21000)
  ptMaxAnnual       Decimal  @db.Decimal(10, 2) @default(2500)
  gratuityRate      Decimal  @db.Decimal(5, 4) @default(0.0577) // 15/26 days
  gratuityMinYears  Int      @default(5)
  standardDeduction Decimal  @db.Decimal(10, 2) @default(75000)
  surchargeSlabs    Json?    // array of {min, max, rate}
  cessRate          Decimal  @db.Decimal(5, 4) @default(0.04)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("statutory_configs")
}

model ProfessionalTaxSlab {
  id           String  @id @default(cuid())
  state        String  // Karnataka, Maharashtra, etc.
  minSalary    Decimal @db.Decimal(12, 2)
  maxSalary    Decimal @db.Decimal(12, 2)
  monthlyTax   Decimal @db.Decimal(10, 2)
  financialYear String
  isActive     Boolean @default(true)

  @@unique([state, minSalary, maxSalary, financialYear])
  @@map("professional_tax_slabs")
}

model TDSSlab {
  id            String  @id @default(cuid())
  regime        String  // OLD, NEW
  financialYear String
  minIncome     Decimal @db.Decimal(15, 2)
  maxIncome     Decimal @db.Decimal(15, 2) // use 999999999 for Infinity
  rate          Decimal @db.Decimal(5, 4)
  isActive      Boolean @default(true)

  @@unique([regime, financialYear, minIncome])
  @@map("tds_slabs")
}

// ── Multi-Level Approval Workflows ──

enum ApprovalStatus {
  PENDING_L1
  PENDING_L2
  PENDING_L3
  APPROVED
  REJECTED
  ESCALATED
  CANCELLED
}

model ApprovalWorkflow {
  id             String         @id @default(cuid())
  entityType     String         // ExpenseClaim, LeaveRecord, PurchaseOrder
  entityId       String
  currentLevel   Int            @default(1)
  maxLevel       Int            @default(2)
  status         ApprovalStatus @default(PENDING_L1)
  initiatedById  String
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  steps          ApprovalStep[]

  @@index([entityType, entityId])
  @@index([status])
  @@map("approval_workflows")
}

model ApprovalStep {
  id           String   @id @default(cuid())
  workflowId   String
  level        Int
  approverId   String
  action       String?  // APPROVED, REJECTED, ESCALATED
  comments     String?
  actionAt     DateTime?
  createdAt    DateTime @default(now())

  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, level, approverId])
  @@map("approval_steps")
}

// ── Payslip Records (generated PDFs) ──

model PayslipDocument {
  id           String   @id @default(cuid())
  salarySlipId String
  employeeId   String
  month        Int
  year         Int
  pdfUrl       String?
  pdfData      Bytes?   // PDF binary for inline storage
  checksum     String?  // SHA-256 of the document
  generatedAt  DateTime @default(now())

  @@unique([salarySlipId])
  @@index([employeeId, year, month])
  @@map("payslip_documents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PHASE 2 — IoT Heartbeat & Time-Series Telemetry
// ═══════════════════════════════════════════════════════════════════════════════

model DeviceHeartbeat {
  id           String   @id @default(cuid())
  deviceId     String
  timestamp    DateTime @default(now())
  cpuUsage     Decimal? @db.Decimal(5, 2)
  memoryUsage  Decimal? @db.Decimal(5, 2)
  diskUsage    Decimal? @db.Decimal(5, 2)
  temperature  Decimal? @db.Decimal(6, 2)
  uptime       Int?     // seconds
  rssi         Int?     // WiFi signal strength dBm
  batteryLevel Decimal? @db.Decimal(5, 2)
  isHealthy    Boolean  @default(true)
  metadata     Json?

  device       IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@index([isHealthy])
  @@map("device_heartbeats")
}

model DeviceAlert {
  id           String   @id @default(cuid())
  deviceId     String
  alertType    String   // OFFLINE, HIGH_TEMP, LOW_BATTERY, MEMORY_CRITICAL, CUSTOM
  severity     String   // INFO, WARNING, CRITICAL
  message      String
  threshold    String?  // e.g., "temperature > 80"
  actualValue  String?
  isResolved   Boolean  @default(false)
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime @default(now())

  device       IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, isResolved])
  @@index([severity, isResolved])
  @@map("device_alerts")
}

model DeviceCommand {
  id           String   @id @default(cuid())
  deviceId     String
  command      String   // RESTART, OTA_UPDATE, CONFIG_PUSH, DIAGNOSTIC
  payload      Json?
  status       String   @default("QUEUED") // QUEUED, SENT, ACKNOWLEDGED, COMPLETED, FAILED
  sentAt       DateTime?
  ackedAt      DateTime?
  completedAt  DateTime?
  response     Json?
  issuedById   String
  createdAt    DateTime @default(now())

  device       IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@map("device_commands")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PHASE 2 — AI Resource Orchestrator
// GPU/CPU allocation, training jobs, trading bots
// ═══════════════════════════════════════════════════════════════════════════════

enum ResourceType {
  GPU
  CPU
  TPU
}

enum ResourceStatus {
  AVAILABLE
  ALLOCATED
  MAINTENANCE
  OFFLINE
}

model ComputeResource {
  id            String         @id @default(cuid())
  name          String
  resourceCode  String         @unique // e.g., "GPU-A100-01"
  type          ResourceType
  status        ResourceStatus @default(AVAILABLE)
  model         String?        // e.g., "NVIDIA A100 80GB", "AMD EPYC 7763"
  vramGb        Int?           // GPU VRAM in GB
  coresCount    Int?
  memoryGb      Int?
  location      String?        // e.g., "Rack-3, DC-BLR-1"
  powerWatts    Int?
  costPerHourINR Decimal?      @db.Decimal(10, 2)
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  allocations   ResourceAllocation[]
  trainingJobs  TrainingJob[]

  @@map("compute_resources")
}

enum AllocationStatus {
  ACTIVE
  COMPLETED
  PREEMPTED
  FAILED
}

model ResourceAllocation {
  id            String           @id @default(cuid())
  resourceId    String
  allocatedToId String           // userId
  purpose       String           // TRAINING, INFERENCE, TRADING_BOT, RESEARCH
  status        AllocationStatus @default(ACTIVE)
  priority      Int              @default(5) // 1-10, 1 = highest
  startedAt     DateTime         @default(now())
  endedAt       DateTime?
  estimatedHours Decimal?        @db.Decimal(8, 2)
  actualHours    Decimal?        @db.Decimal(8, 2)
  costINR        Decimal?        @db.Decimal(12, 2)
  metadata       Json?

  resource      ComputeResource  @relation(fields: [resourceId], references: [id])

  @@index([resourceId, status])
  @@index([allocatedToId])
  @@map("resource_allocations")
}

enum JobStatus {
  QUEUED
  PREPARING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model TrainingJob {
  id              String    @id @default(cuid())
  jobCode         String    @unique // e.g., "TJ-2026-001"
  name            String
  description     String?
  modelName       String    // e.g., "circuvent-nlp-v3", "anomaly-detector-v2"
  framework       String    // PyTorch, TensorFlow, JAX
  resourceId      String?
  requestedById   String
  status          JobStatus @default(QUEUED)
  priority        Int       @default(5)
  datasetPath     String?
  configJson      Json?     // hyperparameters, batch_size, lr, epochs
  outputPath      String?
  metricsJson     Json?     // loss, accuracy, f1 etc.
  epochsCompleted Int       @default(0)
  epochsTotal     Int?
  startedAt       DateTime?
  completedAt     DateTime?
  estimatedTimeMin Int?
  errorLog        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  resource        ComputeResource? @relation(fields: [resourceId], references: [id])
  checkpoints     ModelCheckpoint[]

  @@index([status, priority])
  @@index([requestedById])
  @@map("training_jobs")
}

model ModelCheckpoint {
  id            String   @id @default(cuid())
  jobId         String
  epoch         Int
  stepNumber    Int?
  metricsJson   Json?    // snapshot metrics at this checkpoint
  checkpointPath String
  sizeBytes     BigInt?
  createdAt     DateTime @default(now())

  job           TrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, epoch])
  @@map("model_checkpoints")
}

enum BotStatus {
  INACTIVE
  BACKTESTING
  PAPER_TRADING
  LIVE
  PAUSED
  ERROR
  DECOMMISSIONED
}

model TradingBot {
  id             String    @id @default(cuid())
  botCode        String    @unique // e.g., "TB-ALPHA-01"
  name           String
  description    String?
  strategy       String    // e.g., "mean_reversion", "momentum", "ml_signal"
  modelId        String?   // linked training job output
  status         BotStatus @default(INACTIVE)
  configJson     Json?     // trading parameters, risk limits
  performanceJson Json?    // PnL, Sharpe, drawdown
  deployedAt     DateTime?
  lastTradeAt    DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs           TradingBotLog[]

  @@index([status])
  @@map("trading_bots")
}

model TradingBotLog {
  id          String   @id @default(cuid())
  botId       String
  logLevel    String   @default("INFO") // INFO, WARN, ERROR, TRADE
  message     String
  tradeData   Json?    // { symbol, side, qty, price, pnl }
  timestamp   DateTime @default(now())

  bot         TradingBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, timestamp])
  @@index([logLevel])
  @@map("trading_bot_logs")
}

// ── Session Management (enhanced auth) ──

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  deviceInfo  String?
  isActive    Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, isActive])
  @@map("user_sessions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// EMPLOYEE PORTAL — Extended Models
// Attendance, Performance, Goals, Directory, Announcements,
// Holidays, Documents, Helpdesk, Training & Learning
// ═══════════════════════════════════════════════════════════════════════════════

// ── Attendance & Time Tracking ──

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  WORK_FROM_HOME
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

model AttendanceLog {
  id            String           @id @default(cuid())
  employeeId    String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  totalHours    Decimal?         @db.Decimal(5, 2)
  overtimeHours Decimal?         @db.Decimal(5, 2)
  status        AttendanceStatus @default(PRESENT)
  location      String?          // office / remote / site
  notes         String?
  ipAddress     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([date])
  @@map("attendance_logs")
}

// ── Performance Reviews ──

enum ReviewCycle {
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  PROBATION
}

enum ReviewStatus {
  DRAFT
  SELF_REVIEW
  MANAGER_REVIEW
  HR_REVIEW
  COMPLETED
  ACKNOWLEDGED
}

model PerformanceReview {
  id                String       @id @default(cuid())
  employeeId        String
  reviewerId        String       // manager/reviewer userId
  cycle             ReviewCycle  @default(ANNUAL)
  period            String       // e.g., "Q1-2026", "FY2025-26"
  status            ReviewStatus @default(DRAFT)

  // Ratings (1-5 scale)
  technicalRating   Int?
  communicationRating Int?
  leadershipRating  Int?
  initiativeRating  Int?
  overallRating     Decimal?     @db.Decimal(3, 2) // computed avg

  selfAssessment    String?      @db.Text
  managerComments   String?      @db.Text
  hrComments        String?      @db.Text
  strengths         String?      @db.Text
  areasOfImprovement String?     @db.Text

  promotionRecommended Boolean   @default(false)
  salaryHikePercent    Decimal?  @db.Decimal(5, 2)

  completedAt       DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, cycle])
  @@index([reviewerId])
  @@index([status])
  @@map("performance_reviews")
}

// ── Goals & OKRs ──

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  CANCELLED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Goal {
  id            String       @id @default(cuid())
  employeeId    String
  title         String
  description   String?      @db.Text
  category      String       @default("PROFESSIONAL") // PROFESSIONAL, LEARNING, PROJECT
  priority      GoalPriority @default(MEDIUM)
  status        GoalStatus   @default(NOT_STARTED)
  progress      Int          @default(0) // 0-100
  targetDate    DateTime?
  completedAt   DateTime?
  quarter       String?      // e.g., "Q1-2026"
  keyResults    Json?        // [{ kr: "...", target: 100, current: 50 }]
  managerNotes  String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([quarter])
  @@map("goals")
}

// ── Company Announcements ──

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Announcement {
  id            String               @id @default(cuid())
  title         String
  content       String               @db.Text
  category      String               @default("GENERAL") // GENERAL, HR, IT, EVENT, POLICY
  priority      AnnouncementPriority @default(NORMAL)
  authorId      String
  department    String?              // null = all departments
  isActive      Boolean              @default(true)
  isPinned      Boolean              @default(false)
  attachmentUrl String?
  expiresAt     DateTime?
  publishedAt   DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, publishedAt])
  @@index([category])
  @@map("announcements")
}

// ── Company Holidays ──

enum HolidayType {
  NATIONAL
  REGIONAL
  OPTIONAL
  COMPANY
  RESTRICTED
}

model Holiday {
  id            String      @id @default(cuid())
  name          String
  date          DateTime    @db.Date
  type          HolidayType @default(NATIONAL)
  isOptional    Boolean     @default(false)
  region        String?     // e.g., "KA", "MH", "ALL"
  description   String?
  createdAt     DateTime    @default(now())

  @@unique([date, name])
  @@index([date])
  @@map("holidays")
}

// ── Employee Documents ──

enum DocumentCategory {
  IDENTITY
  EDUCATION
  EXPERIENCE
  POLICY
  OFFER_LETTER
  PAYSLIP
  TAX
  CERTIFICATION
  OTHER
}

model EmployeeDocument {
  id            String           @id @default(cuid())
  employeeId    String
  title         String
  category      DocumentCategory @default(OTHER)
  fileName      String
  fileUrl       String
  fileSize      Int?             // bytes
  mimeType      String?
  uploadedBy    String           // userId who uploaded
  isVerified    Boolean          @default(false)
  verifiedBy    String?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, category])
  @@map("employee_documents")
}

// ── Helpdesk / IT Tickets ──

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  IT_HARDWARE
  IT_SOFTWARE
  IT_ACCESS
  HR_QUERY
  PAYROLL
  FACILITIES
  OTHER
}

model HelpTicket {
  id            String          @id @default(cuid())
  ticketCode    String          @unique // TKT-001
  employeeId    String
  category      TicketCategory  @default(OTHER)
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  subject       String
  description   String          @db.Text
  assignedTo    String?         // userId of IT/HR
  resolution    String?         @db.Text
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  comments      TicketComment[]

  @@index([employeeId, status])
  @@index([status])
  @@index([assignedTo])
  @@map("help_tickets")
}

model TicketComment {
  id            String     @id @default(cuid())
  ticketId      String
  userId        String
  content       String     @db.Text
  isInternal    Boolean    @default(false) // internal notes vs public replies
  createdAt     DateTime   @default(now())

  ticket        HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

// ── Training & Learning ──

enum TrainingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model TrainingProgram {
  id            String          @id @default(cuid())
  title         String
  description   String?         @db.Text
  category      String          @default("TECHNICAL") // TECHNICAL, SOFT_SKILLS, COMPLIANCE, LEADERSHIP
  instructor    String?
  duration      String?         // e.g., "8 hours", "3 days"
  mode          String          @default("ONLINE") // ONLINE, CLASSROOM, HYBRID
  maxSeats      Int?
  status        TrainingStatus  @default(UPCOMING)
  startDate     DateTime?
  endDate       DateTime?
  location      String?
  materials     String?         // URL to materials
  certificate   Boolean         @default(false) // issues certificate
  mandatory     Boolean         @default(false)
  department    String?         // null = all departments
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  enrollments   TrainingEnrollment[]

  @@index([status])
  @@index([category])
  @@map("training_programs")
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
  WAITLISTED
}

model TrainingEnrollment {
  id            String           @id @default(cuid())
  programId     String
  employeeId    String
  status        EnrollmentStatus @default(ENROLLED)
  progress      Int              @default(0) // 0-100
  score         Decimal?         @db.Decimal(5, 2)
  feedback      String?          @db.Text
  certificateUrl String?
  enrolledAt    DateTime         @default(now())
  completedAt   DateTime?

  program       TrainingProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([programId, employeeId])
  @@index([employeeId, status])
  @@map("training_enrollments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 6 — FINANCIAL LEDGER ENGINE
// Double-entry bookkeeping, chart of accounts, GST, trial balance
// ═══════════════════════════════════════════════════════════════════════════════

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LedgerAccount {
  id          String       @id @default(cuid())
  code        String       @unique   // e.g., "1100", "6200"
  name        String
  type        AccountType
  subType     String       // CASH, BANK, ACCOUNTS_RECEIVABLE, etc.
  parentCode  String?
  isPostable  Boolean      @default(true)
  isActive    Boolean      @default(true)
  description String?
  currency    String       @default("INR")
  balance     Decimal      @default(0) @db.Decimal(14, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  journalLines JournalLine[]

  @@index([type])
  @@index([parentCode])
  @@map("ledger_accounts")
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REVERSED
  VOID
}

model JournalEntry {
  id              String        @id @default(cuid())
  entryNumber     String        @unique  // JE-2026-0001
  date            DateTime      @db.Date
  description     String
  source          String        @default("MANUAL") // MANUAL, PAYROLL, INVOICE, EXPENSE
  referenceId     String?       // Link to source document
  status          JournalStatus @default(DRAFT)
  fiscalPeriod    String        // "2026-03"
  createdBy       String
  postedBy        String?
  postedAt        DateTime?
  reversalEntryId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines           JournalLine[]

  @@index([status])
  @@index([fiscalPeriod])
  @@index([source])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id          String   @id @default(cuid())
  journalId   String
  accountCode String
  accountId   String
  debit       Decimal  @default(0) @db.Decimal(14, 2)
  credit      Decimal  @default(0) @db.Decimal(14, 2)
  description String?
  department  String?
  projectId   String?
  createdAt   DateTime @default(now())

  journal     JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account     LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@index([accountCode])
  @@map("journal_lines")
}

model FiscalPeriod {
  id          String   @id @default(cuid())
  period      String   @unique  // "2026-03"
  year        Int
  month       Int
  isClosed    Boolean  @default(false)
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([year])
  @@map("fiscal_periods")
}

model Budget {
  id          String   @id @default(cuid())
  accountCode String
  fiscalYear  String   // "2025-26"
  department  String?
  amount      Decimal  @db.Decimal(14, 2)
  spent       Decimal  @default(0) @db.Decimal(14, 2)
  currency    String   @default("INR")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountCode, fiscalYear, department])
  @@map("budgets")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 7 — RECRUITMENT & ATS ENGINE
// Applicant Tracking System: Job Postings, Candidates, Applications,
// Talent Pools, Interviews, Scoring, Reviewer Assignment
// ═══════════════════════════════════════════════════════════════════════════════

enum PostingStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum JobDivision {
  AI_ML
  IOT_EMBEDDED
  FULL_STACK
  DEVOPS
  DATA_SCIENCE
  DESIGN
  MANAGEMENT
  HR_ADMIN
}

model JobPosting {
  id              String      @id @default(cuid())
  jobCode         String      @unique // JOB-2026-001
  title           String
  description     String      @db.Text
  requirements    String      @db.Text
  division        JobDivision
  department      String
  location        String      @default("Bangalore, India")
  workMode        String      @default("HYBRID") // ONSITE, REMOTE, HYBRID
  employmentType  String      @default("FULL_TIME") // FULL_TIME, CONTRACT, INTERN
  experienceMin   Int         @default(0)
  experienceMax   Int?
  salaryMin       Decimal?    @db.Decimal(12, 2)
  salaryMax       Decimal?    @db.Decimal(12, 2)
  currency        String      @default("INR")
  skills          String[]    // ["TypeScript", "ESP32", "PyTorch"]
  niceToHave      String[]    // ["Prisma", "MQTT", "TensorRT"]
  status          PostingStatus   @default(DRAFT)
  openings        Int         @default(1)
  filled          Int         @default(0)
  hiringManagerId String      // userId of hiring manager
  recruiterId     String?     // userId of assigned recruiter
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  applications    Application[]
  interviews      Interview[]

  @@index([status])
  @@index([division])
  @@index([department])
  @@map("job_postings")
}

enum CandidateSource {
  WEBSITE
  LINKEDIN
  REFERRAL
  NAUKRI
  INDEED
  CAMPUS
  AGENCY
  DIRECT
  OTHER
}

model Candidate {
  id              String          @id @default(cuid())
  candidateCode   String          @unique // CAN-2026-0001
  firstName       String
  lastName        String
  email           String          @unique
  phone           String?
  linkedinUrl     String?
  portfolioUrl    String?
  githubUrl       String?
  currentCompany  String?
  currentRole     String?
  experienceYears Decimal         @default(0) @db.Decimal(4, 1)
  location        String?
  noticePeriod    String?         // "Immediate", "30 days", "60 days"
  currentCTC      Decimal?        @db.Decimal(12, 2)
  expectedCTC     Decimal?        @db.Decimal(12, 2)
  source          CandidateSource @default(WEBSITE)
  referredBy      String?         // employee name/ID
  skills          String[]
  education       Json?           // [{ degree, institution, year, grade }]
  resumeUrl       String?
  resumeText      String?         @db.Text // Extracted text from PDF
  resumeScore     Decimal?        @db.Decimal(5, 2) // 0-100 ATS score
  tags            String[]        // ["High Priority", "IoT Expert", "Silver Medalist"]
  notes           String?         @db.Text
  isBlacklisted   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  applications    Application[]
  poolMemberships TalentPoolMember[]

  @@index([email])
  @@index([source])
  @@map("candidates")
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  TECHNICAL_ROUND
  HR_ROUND
  FINAL_ROUND
  OFFER_EXTENDED
  OFFER_ACCEPTED
  OFFER_DECLINED
  HIRED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

model Application {
  id              String            @id @default(cuid())
  applicationCode String            @unique // APP-2026-0001
  jobId           String
  candidateId     String
  status          ApplicationStatus @default(APPLIED)
  coverLetter     String?           @db.Text
  matchScore      Decimal?          @db.Decimal(5, 2) // 0-100 ATS match
  skillMatchPct   Decimal?          @db.Decimal(5, 2)
  experienceMatch Decimal?          @db.Decimal(5, 2)
  screeningNotes  String?           @db.Text
  rejectionReason String?
  assignedReviewerId String?        // Round-robin assigned
  currentRound    Int               @default(0)
  appliedAt       DateTime          @default(now())
  screenedAt      DateTime?
  shortlistedAt   DateTime?
  offeredAt       DateTime?
  hiredAt         DateTime?
  rejectedAt      DateTime?
  updatedAt       DateTime          @updatedAt

  job             JobPosting        @relation(fields: [jobId], references: [id])
  candidate       Candidate         @relation(fields: [candidateId], references: [id])
  reviews         InterviewReview[]
  interviews      Interview[]
  timeline        ApplicationTimeline[]

  @@unique([jobId, candidateId])
  @@index([status])
  @@index([jobId])
  @@index([candidateId])
  @@index([assignedReviewerId])
  @@map("applications")
}

model ApplicationTimeline {
  id              String    @id @default(cuid())
  applicationId   String
  fromStatus      String
  toStatus        String
  changedBy       String    // userId
  notes           String?
  createdAt       DateTime  @default(now())

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_timelines")
}

enum PoolCategory {
  SILVER_MEDALIST
  NICHE_AI_EXPERT
  IOT_FIRMWARE
  FULL_STACK_PRO
  DEVOPS_SRE
  LEADERSHIP
  INTERN_PIPELINE
  GENERAL
}

model TalentPool {
  id              String        @id @default(cuid())
  name            String        @unique
  category        PoolCategory  @default(GENERAL)
  description     String?
  division        JobDivision?
  managerId       String        // Pool manager userId
  isActive        Boolean       @default(true)
  autoAssignRules Json?         // { skills: ["ESP32"], minExp: 3, source: ["LINKEDIN"] }
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  members         TalentPoolMember[]

  @@index([category])
  @@map("talent_pools")
}

model TalentPoolMember {
  id              String      @id @default(cuid())
  poolId          String
  candidateId     String
  addedBy         String      // userId or "AUTO"
  reason          String?
  priority        String      @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  addedAt         DateTime    @default(now())

  pool            TalentPool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  candidate       Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([poolId, candidateId])
  @@index([poolId])
  @@index([candidateId])
  @@map("talent_pool_members")
}

model Interview {
  id              String    @id @default(cuid())
  applicationId   String
  jobId           String
  interviewerId   String    // userId of interviewer
  roundNumber     Int
  roundType       String    // SCREENING, TECHNICAL, SYSTEM_DESIGN, HR, CULTURE_FIT, FINAL
  scheduledAt     DateTime
  durationMinutes Int       @default(60)
  meetingLink     String?
  location        String?
  status          String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  application     Application @relation(fields: [applicationId], references: [id])
  job             JobPosting  @relation(fields: [jobId], references: [id])
  review          InterviewReview?

  @@index([applicationId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@map("interviews")
}

model InterviewReview {
  id              String    @id @default(cuid())
  interviewId     String    @unique
  applicationId   String
  reviewerId      String    // userId
  decision        String    // STRONG_YES, YES, MAYBE, NO, STRONG_NO
  technicalScore  Int?      // 1-10
  communicationScore Int?   // 1-10
  cultureFitScore Int?      // 1-10
  problemSolvingScore Int?  // 1-10
  overallScore    Decimal?  @db.Decimal(4, 2) // computed average
  strengths       String?   @db.Text
  weaknesses      String?   @db.Text
  notes           String?   @db.Text
  recommendation  String?   @db.Text
  isConfidential  Boolean   @default(false)
  submittedAt     DateTime  @default(now())

  interview       Interview   @relation(fields: [interviewId], references: [id])
  application     Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([reviewerId])
  @@map("interview_reviews")
}

model ReviewerWorkload {
  id              String    @id @default(cuid())
  reviewerId      String    @unique // userId
  reviewerName    String
  department      String
  activeReviews   Int       @default(0)
  totalReviews    Int       @default(0)
  maxCapacity     Int       @default(5)
  isAvailable     Boolean   @default(true)
  lastAssignedAt  DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("reviewer_workloads")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SALARY ADVANCE & RESIGNATION
// ═══════════════════════════════════════════════════════════════════════════════

model SalaryAdvance {
  id              String   @id @default(cuid())
  employeeId      String
  amount          Decimal  @db.Decimal(12, 2)
  reason          String   @db.Text
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, DISBURSED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  repaymentMonths Int      @default(3)
  disbursedAt     DateTime?
  createdAt       DateTime @default(now())
