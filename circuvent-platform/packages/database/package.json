  },
  "devDependencies": {
    "prisma": "^5.10.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
