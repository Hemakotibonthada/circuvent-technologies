{
  "name": "@circuvent/database",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Prisma database client for Circuvent Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
