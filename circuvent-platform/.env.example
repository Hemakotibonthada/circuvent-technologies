# ──────────────────────────────────────────────────────────────
# Circuvent Technologies - Environment Configuration
# ──────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
APP_NAME=Circuvent Platform
APP_VERSION=1.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://circuvent_user:CHANGE_ME@localhost:5432/circuvent_db?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Gateway
GATEWAY_PORT=3000

# Microservice Ports
PROJECT_TRACKER_PORT=3001
IOT_REGISTRY_PORT=3002
HR_PAYROLL_PORT=3003
CLIENT_PORTAL_PORT=3004
AI_ORCHESTRATOR_PORT=3006
FINANCIAL_LEDGER_PORT=3007
ATS_ENGINE_PORT=3008

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Redis (for caching & message queue)
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@circuvent.com
SMTP_PASS=your-smtp-password

# Currency API (for multi-currency)
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
BASE_CURRENCY=INR
