{
  "name": "circuvent-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Circuvent Technologies - Internal Management Platform",
  "scripts": {
    "start": "pnpm run prestart && pnpm run dev",
    "prestart": "pnpm run db:generate",
    "dev": "turbo run dev --concurrency 20",
    "dev:gateway": "pnpm --filter @circuvent/api-gateway dev",
    "dev:web": "pnpm --filter @circuvent/web dev",
    "dev:hr": "pnpm --filter @circuvent/hr-payroll dev",
    "dev:projects": "pnpm --filter @circuvent/project-tracker dev",
    "dev:iot": "pnpm --filter @circuvent/iot-registry dev",
    "dev:clients": "pnpm --filter @circuvent/client-portal dev",
    "dev:ai": "pnpm --filter @circuvent/ai-orchestrator dev",
    "dev:finance": "pnpm --filter @circuvent/financial-ledger dev",
    "dev:ats": "pnpm --filter @circuvent/ats-engine dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @circuvent/database db:generate",
    "db:push": "pnpm --filter @circuvent/database db:push",
    "db:migrate": "pnpm --filter @circuvent/database db:migrate",
    "db:seed": "pnpm --filter @circuvent/database db:seed",
    "db:studio": "pnpm --filter @circuvent/database db:studio",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
