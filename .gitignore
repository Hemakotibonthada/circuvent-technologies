# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local dev data fallback (email evidence log, file store)
/.data/
mobile/dist/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the control-plane template must ship. `.env*` hid platform/.env.example
# from the repository entirely, so nobody cloning it ever saw which variables the
# control plane needs — which is how FEDERATION_SECRET stayed unset and single
# sign-on returned 501 indefinitely. That file carries placeholders only.
#
# Scoped to this one path deliberately: a blanket `!**/.env.example` would also
# start tracking the root template, which holds a real administrator address.
# Opt other templates in individually after checking their contents.
!/platform/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
next-env.d.ts

.vercel

# Shop runtime data (orders/products/wallets)
.data/

# KiCad: local per-user project state, KiCad's own local-history snapshot
# repo, and fab output that gen-pcb.py regenerates from the .kicad_pcb in
# seconds (3D models and IPC-2581)
*.kicad_prl
*.kicad_pro.lck
hardware/*/pcb/.history/
hardware/*/pcb/fab/*.step
hardware/*/pcb/gerbers/*.xml
hardware/__pycache__/

# UI audit reports (generated by scripts/audit-ui.js)
ui-audit.json

# Isolated production build used by scripts/audit-ui.js so a running dev
# server cannot overwrite it.
.next-audit/

# Secrets. scripts/check-no-secrets.js is the guard that actually enforces
# this; these entries only stop the accidental git add .. A keystore or an
# SSH key committed once is in every clone and every fork forever.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
!**/public/**/*.key
upload-keystore.properties
credentials/
# `Creds/` is the same idea under a different name, and `*.key` above would
# already hide the keys themselves — but not a README, a host list or an
# exported known_hosts sitting beside them. The directory is excluded whole so
# that nothing in it can be added by name either.
Creds/
*.vault
circuvent-vault/
id_rsa
id_ed25519

# Workflow SDK local run data. The Local World writes every run, step and
# queue entry here while developing; it is a database, not source. The
# generated route handlers under src/app/.well-known/workflow/ ignore
# themselves, but this one is ours to declare.
.workflow-data/
