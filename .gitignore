# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local dev data fallback (email evidence log, file store)
/.data/
mobile/dist/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
next-env.d.ts

.vercel

# Shop runtime data (orders/products/wallets)
.data/

# KiCad: local per-user project state, KiCad's own local-history snapshot
# repo, and fab output that gen-pcb.py regenerates from the .kicad_pcb in
# seconds (3D models and IPC-2581)
*.kicad_prl
*.kicad_pro.lck
hardware/*/pcb/.history/
hardware/*/pcb/fab/*.step
hardware/*/pcb/gerbers/*.xml
hardware/__pycache__/
