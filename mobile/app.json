{
  "expo": {
    "name": "Circuvent",
    "slug": "circuvent",
    "version": "1.13.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "circuvent",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0b1020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.circuvent.app",
      "buildNumber": "23",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Circuvent connects to your device's setup hotspot to send Wi-Fi credentials during onboarding.",
        "NSCameraUsageDescription": "Circuvent uses the camera to scan the QR label on your device during setup.",
        "NSLocationWhenInUseUsageDescription": "Circuvent uses your location to find and connect to nearby Circuvent devices during setup.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSFaceIDUsageDescription": "Circuvent uses Face ID to unlock the app, so your home stays private if your phone is unlocked and in someone else's hands."
      }
    },
    "android": {
      "package": "com.circuvent.app",
      "versionCode": 23,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png"
      },
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "circuvent.com",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "circuvent.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "circuvent.com",
              "pathPrefix": "/smarthome"
            },
            {
              "scheme": "https",
              "host": "www.circuvent.com",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "www.circuvent.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "www.circuvent.com",
              "pathPrefix": "/smarthome"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "apiBase": "https://circuvent.com"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Circuvent uses the camera to scan the QR label on your device during setup."
        }
      ],
      [
        "react-native-wifi-reborn",
        {
          "fineLocationPermission": true
        }
      ]
    ],
    "newArchEnabled": false
  }
}
