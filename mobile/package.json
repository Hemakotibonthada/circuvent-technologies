{
  "name": "circuvent-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Circuvent - control your Home Hub & AquaGuard devices from iOS & Android.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "icons:check": "node scripts/check-icons.js",
    "version:check": "node scripts/version-check.js",
    "navtargets:check": "node scripts/check-nav-targets.mjs",
    "typecheck": "node scripts/check-nav-targets.mjs && node scripts/version-check.js && node scripts/check-device-types.js && node scripts/check-command-map.js && node scripts/check-contrast.js && node scripts/check-screen-theming.js && node scripts/check-avi-sync.js && node scripts/check-dialogs.js && node scripts/audit-mobile.js && node scripts/audit-swallowed.js && node scripts/check-permissions.js && tsc --noEmit",
    "postinstall": "node scripts/patch-expo-sdk35.js && node scripts/patch-expo-android-publishing.js",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "node scripts/build-android.mjs",
    "build:android:bash": "bash scripts/build-android.sh",
    "android:signing:check": "node scripts/check-android-signing.js",
    "signing:key": "node scripts/check-signing-key.js",
    "devicetypes:check": "node scripts/check-device-types.js",
    "commandmap:check": "node scripts/check-command-map.js",
    "contrast:check": "node scripts/check-contrast.js",
    "ui:audit": "node scripts/audit-mobile.js --list",
    "states:audit": "node scripts/audit-states.js",
    "permissions:check": "node scripts/check-permissions.js",
    "check:16k": "node scripts/check-16k-pages.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/slider": "4.5.6",
    "expo": "~53.0.0",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.11",
    "expo-crypto": "~14.1.5",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-intent-launcher": "~12.1.5",
    "expo-linear-gradient": "~14.1.5",
    "expo-local-authentication": "~16.0.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.5",
    "expo-speech": "~13.1.7",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2",
    "react-native-wifi-reborn": "^4.13.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@napi-rs/canvas": "^1.0.2",
    "@types/react": "~19.0.10",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~5.8.3"
  }
}
