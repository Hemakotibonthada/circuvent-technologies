{
  "name": "circuvent-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Circuvent - control your Home Hub & AquaGuard devices from iOS & Android.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "icons:check": "node scripts/check-icons.js",
    "version:check": "node scripts/version-check.js",
    "typecheck": "node scripts/version-check.js && node scripts/check-device-types.js && node scripts/check-command-map.js && node scripts/check-contrast.js && node scripts/check-screen-theming.js && node scripts/check-avi-sync.js && node scripts/check-dialogs.js && node scripts/audit-mobile.js && node scripts/audit-swallowed.js && node scripts/check-permissions.js && tsc --noEmit",
    "postinstall": "node scripts/patch-expo-sdk35.js && node scripts/patch-expo-android-publishing.js",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "bash scripts/build-android.sh",
    "android:signing:check": "node scripts/check-android-signing.js",
    "devicetypes:check": "node scripts/check-device-types.js",
    "commandmap:check": "node scripts/check-command-map.js",
    "contrast:check": "node scripts/check-contrast.js",
    "ui:audit": "node scripts/audit-mobile.js --list",
    "states:audit": "node scripts/audit-states.js",
    "permissions:check": "node scripts/check-permissions.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "4.5.2",
    "expo": "~51.0.0",
    "expo-blur": "~13.0.3",
    "expo-build-properties": "~0.12.5",
    "expo-camera": "~15.0.16",
    "expo-crypto": "~13.0.2",
    "expo-file-system": "~17.0.1",
    "expo-haptics": "~13.0.1",
    "expo-intent-launcher": "~11.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-notifications": "~0.28.19",
    "expo-speech": "~12.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-svg": "15.2.0",
    "react-native-wifi-reborn": "^4.13.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@napi-rs/canvas": "^1.0.2",
    "@types/react": "~18.2.79",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~5.3.3"
  }
}
